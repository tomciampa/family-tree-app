# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# supabase
supabase/.temp

# saved browser auth session for verification (see CLAUDE.md) — contains a
# live session, never commit
.auth/

# cloudflare-worker: a separate deployment target with its own
# dependencies/local secrets, not part of the Next.js app's own ignores
# above (which only anchor to the repo root).
cloudflare-worker/node_modules
cloudflare-worker/.dev.vars
cloudflare-worker/.wrangler

# typescript
*.tsbuildinfo
next-env.d.ts
